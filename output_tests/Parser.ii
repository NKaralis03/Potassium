    template <typename SymbolTuple, size_t... I>
    bool expand_alternative(std::index_sequence<I...>)
    {
        return (SymbolTraits<std::tuple_element_t<I, SymbolTuple>>().match() && ...);
    }
    template <typename Alternatives, size_t Idx>
    bool try_alternative()
    {
        using alt = std::tuple_element_t<Idx, Alternatives>;
        constexpr size_t num_symbols = std::tuple_size_v<alt>;
        return expand_alternative<alt>(std::make_index_sequence<num_symbols>{});
    }
    template <typename Alternatives, size_t... Indices>
    bool try_all_alternatives(std::index_sequence<Indices...>)
    {
        return (try_alternative<Alternatives, Indices>() || ...);
    }
    template <typename NT>
    bool parse()
    {
        using alts = typename Productions<NT>::alternatives;
        constexpr size_t num_alts = std::tuple_size_v<alts>;
        return try_all_alternatives<alts>(std::make_index_sequence<num_alts>{});
    }
public:
    Token peek_token();
    static bool Parse(std::vector<Token> &tokens);
};
