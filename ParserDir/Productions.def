PROD(file, statements)
PROD(file, )
PROD(statements, function_decl, statements)
PROD(statements, statement, statements)
PROD(statements, NEWLINE, statements)
PROD(statements, )

PROD(function_decl, returnType, IDENTIFIER, LPAREN, parameters, RPAREN, LBRACKET, statement, RBRACKET)
PROD(parameters, parameter, parameters)
PROD(parameters, NEWLINE, parameters)
PROD(parameters, )
PROD(parameter, INTTYPE)

PROD(statement, function_call)
PROD(statement, variable)
PROD(statement, if_statement)
PROD(statement, loop_statement)

PROD(function_call, IDENTIFIER, LPAREN, parameters, RPAREN, SEMICOLON)
PROD(variable, IDENTIFIER, ASSIGNMENT, expression, SEMICOLON)
PROD(variable, INTTYPE, IDENTIFIER, ASSIGNMENT, expression, SEMICOLON)


PROD(expression, factor, expressions)
PROD(expressions, op, factor, expressions)
PROD(expressions, )

PROD(op, AMPERSTAND)
PROD(op, STAR)

PROD(op, PLUS)
PROD(op, MINUS)
PROD(op, NOTEQUALITY)
PROD(op, EQUALITY)
PROD(op, LESSTHAN)

PROD(op, GREATERTHAN)
PROD(op, GE)
PROD(op, LE)
PROD(factor, LPAREN, expressions, RPAREN)
PROD(factor, IDENTIFIER)
PROD(factor, INTEGERCONST)

PROD(if_statement, LPAREN, expression, RPAREN, QUESTIONMARK, RBRACKET, statements, RBRACKET, COLON, LBRACKET, statements, RBRACKET)
PROD(loop_statement, while_statement)
PROD(loop_statement, for_statement)
PROD(while_statement, WHILE, LPAREN, expression, RPAREN, LBRACKET, statements, RBRACKET)
PROD(for_statement, FOR, LPAREN, expression, SEMICOLON, variable, RPAREN, LBRACKET, statements, RBRACKET)

PROD(returnType, INTTYPE)
